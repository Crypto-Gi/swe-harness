#!/usr/bin/env bash
# Self-tests for every script. Each case builds a throwaway git repo.
set -uo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
V="$here/skills/swe-verify/scripts/verified"
G="$here/skills/swe-verify/scripts/test-guard"
R="$here/skills/swe-review/scripts/review-package"
D="$here/skills/swe-bootstrap/scripts/detect-stack"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
pass=0; fail=0
ok()  { pass=$((pass+1)); }
bad() { fail=$((fail+1)); echo "FAIL: $*"; }
# expect <name> <wanted exit> <command...>; output kept in $out
expect() { local name=$1 want=$2; shift 2; out=$("$@" 2>&1); local rc=$?; [ "$rc" = "$want" ] && ok || bad "$name: exit $rc, wanted $want: $out"; }
has() { case "$out" in *"$2"*) ok ;; *) bad "$1: output lacks '$2': $out" ;; esac; }
lacks() { case "$out" in *"$2"*) bad "$1: output has '$2'" ;; *) ok ;; esac; }
newrepo() { rm -rf "$tmp/r"; mkdir "$tmp/r"; cd "$tmp/r"; git init -q -b main .; git config user.email t@t; git config user.name t
  mkdir -p src tests; echo 'def add(a,b): return a+b' > src/m.py
  printf 'def test_add():\n    assert add(1,2) == 3\n    assert add(0,0) == 0\n' > tests/test_m.py
  git add -A; git commit -qm base; }

# --- verified
newrepo
expect "verified pass" 0 bash "$V" unit -- sh -c 'echo line1; echo 2 passed'
has "verified pass" "passed at"; has "verified pass" "2 passed"
[ -f .swe/verified.log ] && [ "$(wc -l < .swe/verified.log)" = 1 ] && ok || bad "verified: ledger should have 1 line"
expect "verified fail" 7 bash "$V" unit -- sh -c 'echo boom; exit 7'
has "verified fail" "NOT recorded"
[ "$(wc -l < .swe/verified.log)" = 1 ] && ok || bad "verified: failing run must not be recorded"
[ -z "$(git status --porcelain)" ] && ok || bad "verified: .swe must ignore itself"
expect "verified usage" 2 bash "$V" unit
echo x >> src/m.py; expect "verified dirty" 0 bash "$V" unit -- true; has "verified dirty" "+uncommitted"

# --- test-guard
newrepo
expect "guard clean" 0 bash "$G" HEAD; has "guard clean" "clean"
echo 'def sub(a,b): return a-b' >> src/m.py
printf 'def test_sub():\n    assert sub(3,1) == 2\n' > tests/test_sub.py
expect "guard clean with new code and test" 0 bash "$G" HEAD
git rm -q tests/test_m.py
expect "guard deleted test" 1 bash "$G" HEAD; has "guard deleted test" "test-deleted"
newrepo
printf 'def test_add():\n    assert add(1,2) == 3\n' > tests/test_m.py
expect "guard removed assertion" 1 bash "$G" HEAD; has "guard removed assertion" "assertions-removed"
newrepo
printf 'def test_add():\n    assert add(1,2) == 3\n    assert add(0,0) == 0 + 0\n' > tests/test_m.py
expect "guard edited assertion is fine" 0 bash "$G" HEAD
newrepo
printf 'import pytest\n@pytest.mark.skip\ndef test_add():\n    assert add(1,2) == 3\n    assert add(0,0) == 0\n' > tests/test_m.py
expect "guard skip" 1 bash "$G" HEAD; has "guard skip" "test-skipped-or-focused"
newrepo
echo 'x = undefined_thing  # noqa' >> src/m.py
expect "guard suppression" 1 bash "$G" HEAD; has "guard suppression" "checker-silenced"
newrepo
echo 'x = 1  # noqa  guard-ok: generated file' >> src/m.py
expect "guard exemption" 0 bash "$G" HEAD
newrepo
printf 'it.only("x", () => { expect(1).toBe(1) })\n' > tests/new.test.js
expect "guard untracked focused test" 1 bash "$G" HEAD; has "guard untracked focused test" "tests/new.test.js"
newrepo
expect "guard bad base" 2 bash "$G" nosuchref
cd "$tmp"; expect "guard outside git" 2 bash "$G"

# --- review-package
newrepo; base=$(git rev-parse HEAD)
expect "review empty" 3 bash "$R" "$base"
echo 'def mul(a,b): return a*b' >> src/m.py; echo new > src/new.py
expect "review worktree" 0 bash "$R" "$base"; has "review worktree" ".swe/review-"
f=$(ls .swe/review-*worktree.diff); grep -q 'def mul' "$f" && ok || bad "review: tracked change missing"
grep -q 'src/new.py' "$f" && ok || bad "review: untracked file missing"
[ -z "$(git diff --cached --name-only)" ] && ok || bad "review: must not touch the index"
git add -A; git commit -qm work; head=$(git rev-parse HEAD)
expect "review range" 0 bash "$R" "$base" "$head"
grep -q '## Commits' .swe/review-*"$(git rev-parse --short "$head")".diff && ok || bad "review: range file"
expect "review reversed" 3 bash "$R" "$head" "$base"
expect "review bad ref" 2 bash "$R" nosuchref
expect "review usage" 2 bash "$R"

# --- detect-stack
rm -rf "$tmp/s"; mkdir -p "$tmp/s/api" "$tmp/s/.github/workflows"; cd "$tmp/s"
printf '{\n  "scripts": {\n    "test": "vitest",\n    "lint": "eslint ."\n  },\n  "dependencies": { "next": "15" }\n}\n' > package.json
touch pnpm-lock.yaml tsconfig.json .github/workflows/ci.yml
printf 'module x\n' > api/go.mod
expect "detect" 0 bash "$D" .
has "detect" "stack: node"; has "detect" "pnpm run test"; has "detect" "pnpm run lint"; lacks "detect" "pnpm run build"
has "detect" "browser UI framework"; has "detect" "stack: go (./api/go.mod)"; has "detect" "ci: .github/workflows/ci.yml"
lacks "detect" "monorepo:"
rm -rf "$tmp/m"; mkdir -p "$tmp/m/packages/a" "$tmp/m/packages/b"; cd "$tmp/m"
printf '{ "workspaces": ["packages/*"], "scripts": { "test": "turbo run test" } }\n' > package.json
printf '{ "scripts": {\n "test": "vitest"\n } }\n' > packages/a/package.json; cp packages/a/package.json packages/b/package.json
printf 'packages:\n  - packages/*\n' > pnpm-workspace.yaml; echo '{}' > turbo.json; touch justfile
expect "detect monorepo" 0 bash "$D" .
has "detect monorepo" "monorepo: pnpm-workspace.yaml package.json:workspaces"; has "detect monorepo" "3 manifests"
has "detect monorepo" "build tool: turborepo"; has "detect monorepo" "task runner: just"; has "detect monorepo" "./packages/a/package.json"
rm -rf "$tmp/c"; mkdir "$tmp/c"; cd "$tmp/c"; printf '[workspace]\nmembers = ["a"]\n' > Cargo.toml; touch go.work MODULE.bazel
expect "detect cargo/go/bazel" 0 bash "$D" .
has "detect cargo/go/bazel" "Cargo.toml:[workspace]"; has "detect cargo/go/bazel" "go.work"; has "detect cargo/go/bazel" "build tool: bazel"

# --- list-docs
L="$here/skills/swe-bootstrap/scripts/list-docs"
rm -rf "$tmp/d"; mkdir -p "$tmp/d/memory" "$tmp/d/repo/docs" "$tmp/d/repo/node_modules/x" "$tmp/d/repo/tests/fixtures" "$tmp/d/repo/my notes"
printf '# Customer rules\n' > "$tmp/d/AGENTS.md"; printf '# Decisions\n' > "$tmp/d/memory/DECISIONS.md"
cd "$tmp/d/repo"; git init -q -b main .
printf '# Repo\n' > README.md; printf 'Design notes\nnever retry writes\n' > design-notes.txt; printf 'flask\n' > requirements.txt
printf 'x\n' > LICENSE; printf '%%PDF-1.4\n' > docs/handoff.pdf; printf 'TOKEN=supersecret\n' > .env; printf 'TOKEN=\n' > .env.example
printf '# vendored\n' > node_modules/x/README.md; printf 'fixture\n' > tests/fixtures/a.txt; printf 'Guide title\n=====\n' > docs/guide.rst
printf 'plain notes\n' > docs/NOTES; printf 'spaced\n' > "my notes/a b.md"; printf 'print(1)\n' > docs/conf.py
expect "list-docs" 0 env HOME=/nonexistent bash "$L" .
has "list-docs" "docs in this repository: 5"; has "list-docs" "design-notes.txt | 2 |"; has "list-docs" "| Design notes"
has "list-docs" "docs/guide.rst"; has "list-docs" "docs/NOTES"; has "list-docs" "my notes/a b.md"; has "list-docs" "| Repo"
has "list-docs" "../AGENTS.md"; has "list-docs" "../memory/DECISIONS.md"
has "list-docs" "listed, not opened (1)"; has "list-docs" "docs/handoff.pdf"; has "list-docs" "never opened (1)"
has "list-docs" "skipped: 2 doc-like files"
lacks "list-docs" "requirements.txt"; lacks "list-docs" "LICENSE"; lacks "list-docs" "conf.py"; lacks "list-docs" ".env.example"
lacks "list-docs" "supersecret"; lacks "list-docs" "fixtures/a.txt"
expect "list-docs cap" 0 env HOME=/nonexistent LIST_DOCS_CAP=2 bash "$L" .
has "list-docs cap" "... 3 more not listed (cap 2)"
expect "list-docs home stop" 0 env HOME="$tmp/d" bash "$L" .
lacks "list-docs home stop" "../AGENTS.md"

# --- install.sh (core only, no network)
h="$tmp/home"; mkdir -p "$h/.claude"; printf '# mine\nkeep me\n' > "$h/.claude/CLAUDE.md"
out=$(HOME="$h" GIT_ALLOW_PROTOCOL=none sh "$here/install.sh" 2>&1); rc=$?
[ "$rc" = 0 ] && ok || bad "install core: exit $rc: $out"
for d in .claude/skills .agents/skills; do
  [ "$(ls "$h/$d" | tr '\n' ' ')" = "swe-bootstrap swe-change swe-debug swe-review swe-verify " ] && ok || bad "install core: $d has: $(ls "$h/$d" | tr '\n' ' ')"
done
out=$(HOME="$h" sh "$here/install.sh" browser 2>&1); [ -f "$h/.claude/skills/swe-browser-check/SKILL.md" ] && ok || bad "install browser: $out"
expect "install bad arg" 1 env HOME="$h" sh "$here/install.sh" nosuch
[ "$(cat "$h/.agents/skills/swe-change/.swe-harness-version")" = "$(cat "$here/VERSION")" ] && ok || bad "install: version stamp missing"
expect "install version" 0 env HOME="$h" sh "$here/install.sh" version; has "install version" "$(cat "$here/VERSION")"
c="$h/.claude/CLAUDE.md"
[ "$(grep -c '^<!-- swe-harness:start' "$c")" = 1 ] && grep -q 'swe-change skill' "$c" && grep -q '^keep me$' "$c" && ok || bad "pointer: want one block plus the user's lines after two installs: $(cat "$c")"
[ ! -e "$h/.codex" ] && ok || bad "pointer: created ~/.codex for a user without Codex"
mkdir "$h/.codex"; HOME="$h" sh "$here/install.sh" >/dev/null 2>&1
grep -q 'swe-review skill' "$h/.codex/AGENTS.md" 2>/dev/null && ok || bad "pointer: no block in ~/.codex/AGENTS.md when ~/.codex exists"
mkdir -p "$h/.claude/skills/someone-else"
expect "install uninstall" 0 env HOME="$h" sh "$here/install.sh" uninstall
[ ! -e "$h/.claude/skills/swe-change" ] && [ ! -e "$h/.agents/skills/swe-browser-check" ] && ok || bad "uninstall: swe skills left behind"
[ -d "$h/.claude/skills/someone-else" ] && ok || bad "uninstall: removed a skill it did not install"
[ "$(cat "$c")" = "$(printf '# mine\nkeep me')" ] && ok || bad "uninstall: CLAUDE.md not restored to the user's lines: $(cat "$c")"
[ ! -e "$h/.codex/AGENTS.md" ] && ok || bad "uninstall: left an AGENTS.md that only held the block"
# manifest: every entry pinned to a full commit
while IFS='|' read -r key name repo commit path licence; do
  case "$key" in ''|\#*) continue ;; esac
  echo "$commit" | grep -Eq '^[0-9a-f]{40}$' && [ -n "$licence" ] && [ "${name#swe-}" != "$name" ] && ok || bad "optional/sources: entry '$key' needs a 40-hex commit, a licence and a swe- name"
done < "$here/optional/sources"

rm -rf "$tmp/e"; mkdir "$tmp/e"; expect "detect empty" 0 bash "$D" "$tmp/e"; has "detect empty" "none detected"

echo "script tests: $pass passed, $fail failed"
[ "$fail" = 0 ]
