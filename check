#!/usr/bin/env bash
# Full check for this repo. Exit 0 means every part passed.
# ./check --network also fetches the pinned optional skills into a throwaway HOME.
set -uo pipefail
cd "$(dirname "$0")"
fail=0
err() { echo "FAIL: $*"; fail=1; }

# 1. Skill lint
for d in skills/*/ optional/*/; do
  n=$(basename "$d"); f="$d/SKILL.md"
  [ -f "$f" ] || { err "$n: no SKILL.md"; continue; }
  [ "$(sed -n 1p "$f")" = "---" ] || err "$n: frontmatter must start on line 1"
  name=$(awk '/^---$/{c++; next} c==1 && /^name:/{sub(/^name:[ \t]*/,""); print; exit}' "$f")
  [ "$name" = "$n" ] || err "$n: frontmatter name '$name' does not match folder"
  desc=$(awk '/^---$/{c++; next} c==1 && /^description:/{sub(/^description:[ \t]*/,""); print; exit}' "$f")
  [ -n "$desc" ] || err "$n: no description"
  [ "${#desc}" -le 1024 ] || err "$n: description is ${#desc} chars (limit 1024)"
  case "$n" in swe-*) ;; *) err "$n: folder must start with swe-" ;; esac
  # every references/, scripts/ or assets/ path named in SKILL.md must exist
  for p in $(grep -oE '(references|scripts|assets)/[A-Za-z0-9._/-]+' "$f" | sort -u); do
    [ -e "$d/$p" ] || err "$n: SKILL.md names $p, which does not exist"
  done
  grep -q "$n" README.md || err "$n: not listed in README.md"
done
# skills we wrote use only name + description
for f in skills/*/SKILL.md optional/*/SKILL.md; do
  n=$(basename "$(dirname "$f")")
  extra=$(awk '/^---$/{c++; next} c==1 && /^[A-Za-z_-]+:/ && !/^(name|description):/' "$f")
  [ -z "$extra" ] || err "$n: extra frontmatter keys: $extra"
done
# bootstrap template stays small
lines=$(wc -l < skills/swe-bootstrap/assets/AGENTS.template.md)
[ "$lines" -le 100 ] || err "AGENTS.template.md is $lines lines (limit 100)"
# scripts parse
for s in skills/*/scripts/* tests/run check; do
  [ -f "$s" ] || continue
  case "$s" in *.cjs|*.js|*.py|*.json) continue ;; esac
  bash -n "$s" 2>/dev/null || err "$s: syntax error"
done
sh -n install.sh 2>/dev/null || err "install.sh: syntax error"
[ ! -d skills/swe-security-audit ] && [ ! -d skills/swe-react ] || err "vendor skills must not be stored in this repo; they are fetched via optional/sources"
[ "$fail" = 0 ] && echo "ok: skill lint"

# zips are byte-reproducible; a stale one is a bug
if command -v python3 >/dev/null 2>&1; then
  z=$(mktemp -d); cp -R skills optional install.sh "$z"/
  (cd "$z" && sh ./install.sh zip >/dev/null)
  for f in "$z"/zips/*.zip; do cmp -s "$f" "zips/$(basename "$f")" || err "zips/$(basename "$f") is stale: run ./install.sh zip"; done
  [ "$(ls zips | wc -l)" = "$(ls "$z"/zips | wc -l)" ] || err "zips/ holds files install.sh zip does not build"
  rm -rf "$z"
fi

# 2. Script tests
bash tests/run || fail=1

# 3. Optional, needs network: fetch each pinned specialist skill into a throwaway HOME
if [ "${1:-}" = "--network" ]; then
  h=$(mktemp -d)
  if HOME="$h" sh ./install.sh security react >/dev/null 2>&1 \
     && grep -q '^name: swe-security-audit$' "$h/.agents/skills/swe-security-audit/SKILL.md" \
     && grep -q '^name: swe-react$' "$h/.claude/skills/swe-react/SKILL.md" \
     && grep -q '^commit: ' "$h/.claude/skills/swe-react/SOURCE" \
     && [ ! -e "$h/.claude/skills/swe-react/AGENTS.md" ] && ! grep -q "Compiled Document" "$h/.claude/skills/swe-react/SKILL.md"; then echo "ok: pinned fetch of optional skills"; else err "pinned fetch of optional skills"; fi
  rm -rf "$h"
fi

[ "$fail" = 0 ] && echo "ALL CHECKS PASSED" || echo "CHECKS FAILED"
exit "$fail"
