#!/usr/bin/env bash
# eval/run [MODEL] : run every task below against a fresh copy of the fixture, in real headless Claude Code
# sessions, and check the result. Costs real usage (about $2-3 per full run on Sonnet).
# Each session gets its own config folder holding only what ./install.sh would put in ~/.claude: the core
# skills and the pointer.md block. EVAL_ARM=without runs the same tasks with neither, as a baseline.
# Default model: claude-sonnet-5-5, the default most people get. Needs the `claude` CLI, logged in.
# Results: eval/results/<timestamp>/ (git-ignored). Exit 1 if any check fails.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd); repo=$(dirname "$here")
model=${1:-claude-sonnet-5-5}
command -v claude >/dev/null || { echo "eval: the claude CLI is not installed" >&2; exit 2; }
out="$here/results/$(date +%Y%m%d-%H%M%S)"; mkdir -p "$out"
fail=0

session() { # session NAME DIR PROMPT
  local cfg="$out/$1.config"; mkdir -p "$cfg"
  if [ "${EVAL_ARM:-with}" != without ]; then
    mkdir -p "$cfg/skills"; cp -R "$repo"/skills/* "$cfg/skills/"; cp "$repo/pointer.md" "$cfg/CLAUDE.md"
  fi
  (cd "$2" && env -u CLAUDE_CODE_SYNC_PLUGINS -u CLAUDE_CODE_SYNC_SKILLS CLAUDE_CONFIG_DIR="$cfg" \
     timeout 1200 claude -p "$3" --model "$model" --output-format stream-json --verbose --max-turns 80 \
     --setting-sources user,project --allowedTools "Bash Edit Write Read Glob Grep Skill Agent" > "$out/$1.jsonl" 2> "$out/$1.err")
}
used() { grep -Eq "\"name\":\"Skill\",\"input\":\\{\"skill\":\"$2\"|$2/SKILL\\.md" "$out/$1.jsonl"; }   # used NAME SKILL
ran()  { grep -q "$2" "$out/$1.jsonl"; }                                               # ran NAME TEXT
check() { # check NAME DESCRIPTION COMMAND...
  local n=$1 d=$2; shift 2
  if "$@"; then echo "  pass  $n: $d"; else echo "  FAIL  $n: $d"; fail=1; fi
}
fresh() { # fresh NAME [bootstrapped] : a new fixture copy
  local d="$out/$1"; bash "$here/fixture.sh" "$d" >/dev/null
  if [ "${2:-}" = bootstrapped ]; then
    printf '# invoicer\n\nBefore any work, read `agent-guide.md`.\n\n## How to work here\n- Any code change follows `swe-change`.\n' > "$d/AGENTS.md"
    printf '# invoicer: agent guide\n\n## Commands\n- Full check: `make test`\n' > "$d/agent-guide.md"
    printf '@AGENTS.md\n@agent-guide.md\n' > "$d/CLAUDE.md"
    (cd "$d" && git -c user.name=eval -c user.email=eval@example.com add -A && git -c user.name=eval -c user.email=eval@example.com commit -qm "agent guide")
  fi
  echo "$d"
}
unchanged() { (cd "$1" && git diff --quiet HEAD -- invoicer tests); }   # unchanged DIR : no source or test edits

echo "eval: model $model, results in $out"

echo "1. bootstrap"
d=$(fresh bootstrap)   # the user already has their own AGENTS.md
printf '# House rules\n\n- Write commit messages in British English.\n- Never touch vendor/ without asking Sam.\n' > "$d/AGENTS.md"
(cd "$d" && git -c user.name=eval -c user.email=eval@example.com add -A && git -c user.name=eval -c user.email=eval@example.com commit -qm "house rules")
session bootstrap "$d" "bootstrap this project (hybrid storage mode is fine)"
check bootstrap "swe-bootstrap fired" used bootstrap swe-bootstrap
check bootstrap "agent-guide.md written, at most 100 lines" test -f "$d/agent-guide.md" -a "$(wc -l < "$d/agent-guide.md" 2>/dev/null || echo 999)" -le 100
check bootstrap "agent-guide.md holds the check command" grep -q 'unittest\|make test' "$d/agent-guide.md"
check bootstrap "the user's AGENTS.md lines are all still there" bash -c "cd '$d' && git show HEAD:AGENTS.md | while IFS= read -r l; do grep -qxF -- \"\$l\" AGENTS.md || exit 1; done"
check bootstrap "AGENTS.md now points to agent-guide.md" grep -q 'agent-guide.md' "$d/AGENTS.md"
check bootstrap "CLAUDE.md loads both files" bash -c "grep -qx '@AGENTS.md' '$d/CLAUDE.md' && grep -qx '@agent-guide.md' '$d/CLAUDE.md'"
check bootstrap "no source code changed" unchanged "$d"
check bootstrap "listed the docs before writing" ran bootstrap "list-docs"
check bootstrap "no test counts or known-bug section in agent-guide.md" bash -c "! grep -Eiq '[0-9]+ tests|^#+ *known' '$d/agent-guide.md'"

echo "2. bug report, repo not bootstrapped"
d=$(fresh bug); session bug "$d" "python3 -m invoicer sample.csv crashes with InvalidOperation. Fix it."
check bug "swe-change fired without AGENTS.md" used bug swe-change
check bug "fix works on sample.csv" bash -c "cd '$d' && python3 -m invoicer sample.csv >/dev/null"
check bug "a test was added" bash -c "cd '$d' && ! git diff --quiet HEAD -- tests || git ls-files --others --exclude-standard tests | grep -q ."
check bug "verified recorder used" test -s "$d/.swe/verified.log"
check bug "test-guard run" ran bug "test-guard"
check bug "no review started unasked" bash -c "! grep -Eq '\"skill\":\"(swe-review|code-review)\"' '$out/bug.jsonl'"
check bug "not committed (nobody asked)" test "$(cd "$d" && git rev-list --count HEAD)" = 1

echo "3. feature with commit"
d=$(fresh feature bootstrapped); session feature "$d" "Add a --json flag to the CLI that prints items, subtotal and total as JSON. Commit it when done."
check feature "swe-change fired" used feature swe-change
check feature "one new commit" test "$(cd "$d" && git rev-list --count HEAD)" = 3
check feature "README updated in that commit" bash -c "cd '$d' && git show --name-only HEAD | grep -qx README.md"
check feature "commit message has a body (the why)" bash -c "cd '$d' && [ \$(git log -1 --format=%b | grep -c .) -ge 1 ]"
check feature "verified recorder used" test -s "$d/.swe/verified.log"
check feature "no review started unasked" bash -c "! grep -Eq '\"skill\":\"(swe-review|code-review)\"' '$out/feature.jsonl'"

echo "4. vague performance request"
d=$(fresh perf bootstrapped); session perf "$d" "invoicer feels slow, make it faster"
check perf "no code changed without a measurement" bash -c "cd '$d' && git diff --quiet HEAD -- invoicer || grep -qiE 'baseline|before:|measured|timeit|time ' '$out/perf.jsonl'"

echo "5. review"
d=$(fresh review bootstrapped)
(cd "$d" && sed -i 's/lstrip("\$"))/lstrip("$").replace(",", ""))/' invoicer/core.py && git -c user.name=eval -c user.email=eval@example.com commit -qam "Accept thousands separators")
session review "$d" "Review my last commit before I push it."
check review "swe-review fired" used review swe-review
check review "found the silent misparse of decimal commas" bash -c "grep -Eiq '12,50|1,25|decimal comma|european|silently' '$out/review.jsonl'"
check review "ranked it FIX NOW" grep -q 'FIX NOW' "$out/review.jsonl"
check review "plain review request: one reviewer, no built-in code-review" bash -c "! grep -q '\"skill\":\"code-review\"' '$out/review.jsonl'"
check review "changed nothing" bash -c "cd '$d' && git diff --quiet HEAD"

echo "6. one-line rename"
d=$(fresh rename); session rename "$d" "Rename the function subtotal to items_subtotal everywhere."
check rename "swe-change fired on a one-line edit" used rename swe-change
check rename "tests still pass" bash -c "cd '$d' && make test >/dev/null 2>&1"

echo "7. a rule from outside the code survives a later cleanup"
d=$(fresh rule1); session rule1 "$d" "Tax must be rounded per line item, half-up, to the cent, not once on the total. Our accountant requires this because printed invoices show per-line amounts and they have to add up exactly. Please change the code and commit."
per_line() { (cd "$1" && printf 'description,quantity,unit_price\nA,1,0.10\nB,1,0.10\nC,1,0.10\n' > "$out/t.csv" && python3 -m invoicer "$out/t.csv" --tax 0.25 | grep -q 'total: 0.39'); }
check rule1 "per-line rounding in force" per_line "$d"
check rule1 "the outside reason is kept where the next editor looks" bash -c "cd '$d' && { git log -1 --format=%B; grep -rh -i accountant invoicer docs 2>/dev/null; } | grep -qi accountant"
session rule2 "$d" "The totals code in invoicer is more complicated than it needs to be. Simplify it: add up the line items, then apply tax once to the subtotal. Commit when done."
check rule2 "a fresh session did not undo the rule" per_line "$d"
check rule2 "it asked before undoing it" bash -c "grep '\"type\":\"result\"' '$out/rule2.jsonl' | grep -Eqi 'accountant.*(confirm|ask|want|before)|(confirm|ask|want|before).*accountant'"

grep -h '"type":"result"' "$out"/*.jsonl | python3 -c "import sys,json; print('cost: \$%.2f' % sum(json.loads(l).get('total_cost_usd') or 0 for l in sys.stdin))"
[ "$fail" = 0 ] && echo "eval: all checks passed" || echo "eval: some checks failed (see $out)"
exit "$fail"
